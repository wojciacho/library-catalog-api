@LibraryCatalog_HostAddress = http://localhost:5147

### 1. Register a user (safe to re-run - a repeat call returns 409 Conflict)
POST {{LibraryCatalog_HostAddress}}/Auth/register
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

### 2. Log in - captures the token for the requests below
# @name login
POST {{LibraryCatalog_HostAddress}}/Auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

### 3. GET all books (initial state)
GET {{LibraryCatalog_HostAddress}}/Books
Authorization: Bearer {{login.response.body.*}}

### 4. POST a new book
POST {{LibraryCatalog_HostAddress}}/Books
Authorization: Bearer {{login.response.body.*}}
Content-Type: application/json

{
  "title": "Test Driven Development",
  "author": "Kent Beck"
}

### 5. GET all - check that the new book was added
GET {{LibraryCatalog_HostAddress}}/Books
Authorization: Bearer {{login.response.body.*}}

### 6. GET by id of the newly created book (change id to the one returned by POST)
GET {{LibraryCatalog_HostAddress}}/Books/1
Authorization: Bearer {{login.response.body.*}}

### 7. PUT - update the newly created book
PUT {{LibraryCatalog_HostAddress}}/Books/1
Authorization: Bearer {{login.response.body.*}}
Content-Type: application/json

{
  "title": "Test Driven Development (2nd Edition)",
  "author": "Kent Beck"
}

### 8. GET by id - check that PUT actually changed the data
GET {{LibraryCatalog_HostAddress}}/Books/1
Authorization: Bearer {{login.response.body.*}}

### 9. DELETE - remove the book
DELETE {{LibraryCatalog_HostAddress}}/Books/1
Authorization: Bearer {{login.response.body.*}}

### 10. GET all - check it's gone
GET {{LibraryCatalog_HostAddress}}/Books
Authorization: Bearer {{login.response.body.*}}

### 11. GET by id of the deleted book - should be 404
GET {{LibraryCatalog_HostAddress}}/Books/1
Authorization: Bearer {{login.response.body.*}}

### 12. PUT on a non-existent id - should be 404
PUT {{LibraryCatalog_HostAddress}}/Books/999
Authorization: Bearer {{login.response.body.*}}
Content-Type: application/json

{
  "title": "Does not exist",
  "author": "Nobody"
}

### 13. DELETE on a non-existent id - should be 404
DELETE {{LibraryCatalog_HostAddress}}/Books/999
Authorization: Bearer {{login.response.body.*}}

### 14. GET all books without a token - should be 401
GET {{LibraryCatalog_HostAddress}}/Books
